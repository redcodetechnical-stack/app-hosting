{
  "name": "vitalora-api",
  "version": "1.0.0",
  "private": true,
  "description": "Vitalora wellness platform - backend API (Next.js route handlers, PostgreSQL, Drizzle ORM)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build-web.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "tsx tests/e2e.ts",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.6.1",
    "jose": "6.0.11",
    "next": "15.5.29",
    "pg": "8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "@types/react": "19.1.6",
    "dotenv": "16.5.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}