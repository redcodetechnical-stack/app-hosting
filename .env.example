# ---------- Core (required) ----------
DATABASE_URL="postgresql://vitalora:password@localhost:5432/vitalora"
DATABASE_SSL=false                 # true for managed Postgres that needs TLS
APP_URL="http://localhost:3000"    # public URL of the web app / API (OAuth redirects, CSRF origin)
CORS_ORIGINS=""                    # extra allowed origins, comma separated (e.g. the mobile web build)
APP_ENV=development                # development | test | staging | production  (production disables sandbox + dev OTP codes)
JWT_SECRET=""                      # openssl rand -base64 48
ENCRYPTION_KEY=""                  # 32 bytes: openssl rand -hex 32   (encrypts journal, notes, AI chats, OAuth tokens)
OTP_SECRET=""                      # openssl rand -base64 32
CRON_SECRET=""                     # openssl rand -hex 24  (Authorization: Bearer for /api/cron/reminders)
REDIS_URL=""                       # optional; shared rate limits across instances
SANDBOX_MODE=false                 # true in development only: sandbox AI replies and sandbox wearables

# ---------- First super admin (used by npm run db:seed) ----------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""             # 12+ characters

# ---------- Plans ----------
FREE_TRIAL_DAYS=7

# ---------- AI ----------
AI_PROVIDER=anthropic              # anthropic | openai
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# ---------- Sign-in providers ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""                 # Services ID
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""               # .p8 contents, newlines as \n

# ---------- SMS / email / push ----------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
RESEND_API_KEY=""
EMAIL_FROM="Vitalora <no-reply@yourdomain.in>"
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""                 # service-account private key, newlines as \n

# ---------- Payments ----------
PAYMENT_PROVIDER=razorpay          # razorpay | stripe
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- Wearables ----------
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_SUBSCRIBER_VERIFY=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""
HEALTH_INGEST_SIGNING_KEY=""       # set to enable Apple Health / Health Connect uploads from the native apps

# ---------- Food data ----------
OPENFOODFACTS_ENABLED=true
NUTRITIONIX_APP_ID=""
NUTRITIONIX_API_KEY=""
EDAMAM_APP_ID=""
EDAMAM_APP_KEY=""

# ---------- Media, video, maps ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
DAILY_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# ---------- Legal pages (/privacy, /terms) ----------
COMPANY_NAME="Vitalora Healthcare"
COMPANY_ADDRESS=""
SUPPORT_EMAIL=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_OFFICER_EMAIL=""
